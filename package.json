{
  "name": "explainer-channel",
  "version": "1.0.0",
  "description": "YouTube Shorts Explainer Production Engine",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion render",
    "upgrade": "remotion upgrade",
    "validate": "tsx scripts/validate-episode.ts",
    "validate:all": "tsx scripts/validate-episode.ts --all",
    "scaffold": "tsx scripts/scaffold-episode.ts",
    "episodes": "tsx scripts/list-episodes.ts",
    "tts:edge": "uv run scripts/tts/generate-edge.py",
    "tts:elevenlabs": "uv run scripts/tts/generate-elevenlabs.py"
  },

  "dependencies": {
    "@remotion/captions": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "@remotion/media-utils": "^4.0.0",
    "@remotion/paths": "^4.0.0",
    "@remotion/shapes": "^4.0.0",
    "@remotion/tailwind": "^4.0.0",
    "@remotion/transitions": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  }
}
